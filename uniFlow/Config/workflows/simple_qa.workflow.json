{
  "id": "simple_qa_workflow",
  "name": "简单问答工作流",
  "version": "1.0",
  "description": "演示基础的问答流程：输入校验 → LLM调用 → 输出校验",
  "author": "UniFlow Team",
  "enabled": true,
  "startStep": "validate_input",
  
  "inputVariables": [
    {
      "name": "user_input",
      "type": "0",
      "required": true,
      "description": "用户输入的问题"
    },
    {
      "name": "session_id",
      "type": "0",
      "required": false,
      "description": "会话ID"
    }
  ],
  
  "outputVariables": [
    {
      "name": "response",
      "type": "0"
    },
    {
      "name": "success",
      "type": "3"
    }
  ],
  
  "steps": [
    {
      "id": "validate_input",
      "name": "输入校验",
      "description": "使用 Guard 校验用户输入",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "guard",
        "target": "validate_input",
        "input": {
          "content": "${user_input}"
        },
        "outputVar": "validation_result",
        "timeout": 5000
      },
      "next": "check_validation",
      "onError": "handle_error"
    },
    {
      "id": "check_validation",
      "name": "检查校验结果",
      "description": "根据校验结果决定下一步",
      "type": "condition",
      "enabled": true,
      "condition": {
        "left": "$validation_result.valid",
        "op": "eq",
        "right": "true"
      },
      "branches": [
        {
          "condition": {
            "left": "$validation_result.valid",
            "op": "eq",
            "right": "true"
          },
          "next": "call_llm"
        },
        {
          "condition": {
            "left": "$validation_result.valid",
            "op": "eq",
            "right": "false"
          },
          "next": "reject_input"
        }
      ],
      "next": "call_llm"
    },
    {
      "id": "reject_input",
      "name": "拒绝输入",
      "description": "输入不合法时返回错误",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "assign",
        "target": "response",
        "input": {
          "value": "您的输入不符合安全规范，请重新输入。"
        },
        "outputVar": "response"
      },
      "next": "set_failure"
    },
    {
      "id": "set_failure",
      "name": "设置失败状态",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "assign",
        "target": "success",
        "input": {
          "value": false
        },
        "outputVar": "success"
      },
      "next": "end_workflow"
    },
    {
      "id": "call_llm",
      "name": "调用 LLM",
      "description": "发送问题到 LLM 获取回答",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "llm",
        "target": "default",
        "input": {
          "prompt": "${user_input}",
          "max_tokens": 500,
          "temperature": 0.7
        },
        "outputVar": "llm_result",
        "timeout": 30000,
        "retryCount": 2,
        "retryDelay": 1000
      },
      "next": "validate_output",
      "onError": "handle_llm_error"
    },
    {
      "id": "handle_llm_error",
      "name": "处理 LLM 错误",
      "description": "LLM 调用失败时的处理",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "assign",
        "target": "response",
        "input": {
          "value": "抱歉，AI 服务暂时不可用，请稍后再试。"
        },
        "outputVar": "response"
      },
      "next": "set_failure"
    },
    {
      "id": "validate_output",
      "name": "输出校验",
      "description": "校验 LLM 输出是否安全",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "guard",
        "target": "validate_output",
        "input": {
          "content": "${llm_result.content}"
        },
        "outputVar": "output_validation",
        "timeout": 5000
      },
      "next": "prepare_response"
    },
    {
      "id": "prepare_response",
      "name": "准备响应",
      "description": "整理最终响应",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "assign",
        "target": "response",
        "input": {
          "value": "${llm_result.content}"
        },
        "outputVar": "response"
      },
      "next": "set_success"
    },
    {
      "id": "set_success",
      "name": "设置成功状态",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "assign",
        "target": "success",
        "input": {
          "value": true
        },
        "outputVar": "success"
      },
      "next": "log_result"
    },
    {
      "id": "log_result",
      "name": "记录结果",
      "description": "记录审计日志",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "log",
        "target": "audit",
        "input": {
          "event_type": "QA_COMPLETED",
          "session_id": "${session_id}",
          "input_length": "${user_input.length}",
          "success": "${success}"
        }
      },
      "next": "end_workflow"
    },
    {
      "id": "handle_error",
      "name": "通用错误处理",
      "description": "处理未预期的错误",
      "type": "action",
      "enabled": true,
      "action": {
        "type": "assign",
        "target": "response",
        "input": {
          "value": "处理您的请求时发生错误，请稍后再试。"
        },
        "outputVar": "response"
      },
      "next": "set_failure"
    },
    {
      "id": "end_workflow",
      "name": "结束",
      "type": "end",
      "enabled": true
    }
  ],
  
  "tags": ["qa", "demo", "simple"],
  
  "metadata": {
    "category": "问答",
    "complexity": "simple",
    "estimated_time_ms": 5000
  }
}
