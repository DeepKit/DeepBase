@echo off\nREM Project initialization script - rename and setup new project from UniBaseRun template\nREM Usage: init-project.bat [NewProjectName]\n\nsetlocal enabledelayedexpansion\n\necho ============================================\necho UniBaseRun Project Initialization\necho ============================================\necho.\n\nif \"%1\"==\"\" (\n    set /p NewName=\"Enter new project name (default: UniBaseRun): \"\n    if \"!NewName!\"==\" \" set NewName=UniBaseRun\n) else (\n    set NewName=%1\n)\n\nif \"!NewName!\"==\"UniBaseRun\" (\n    echo.\n    echo Using default name: UniBaseRun\n    echo Initialization skipped.\n    exit /b 0\n)\n\necho.\necho Initializing project: !NewName!\necho.\n\ncd /d \"%~dp0..\"\n\nREM Check if Delphi project files exist\nif not exist \"UniBaseRun.dproj\" (\n    echo Error: UniBaseRun.dproj not found\n    exit /b 1\n)\n\nif not exist \"UniBaseRun.dpr\" (\n    echo Error: UniBaseRun.dpr not found\n    exit /b 1\n)\n\nREM Rename .dproj file\necho Renaming project files...\nif exist \"!NewName!.dproj\" del \"!NewName!.dproj\"\nren \"UniBaseRun.dproj\" \"!NewName!.dproj\"\nif errorlevel 1 (\n    echo Error: Failed to rename .dproj file\n    exit /b 1\n)\n\nREM Rename .dpr file\nif exist \"!NewName!.dpr\" del \"!NewName!.dpr\"\nren \"UniBaseRun.dpr\" \"!NewName!.dpr\"\nif errorlevel 1 (\n    echo Error: Failed to rename .dpr file\n    exit /b 1\n)\n\nREM Update project name in .dproj file\necho Updating project references...\npowershell -Command \"(\n    $content = Get-Content '!NewName!.dproj' -Raw;\n    $content = $content -replace 'UniBaseRun', '!NewName!';\n    Set-Content '!NewName!.dproj' -Value $content;\n)\"\n\nREM Update program name in .dpr file\npowershell -Command \"(\n    $content = Get-Content '!NewName!.dpr' -Raw;\n    $content = $content -replace 'program UniBaseRun', 'program !NewName!';\n    Set-Content '!NewName!.dpr' -Value $content;\n)\"\n\nREM Update root.txt with current directory\necho Updating root.txt...\necho %cd%> root.txt\n\necho.\necho ============================================\necho Initialization completed!\necho ============================================\necho.\necho New project created: !NewName!\necho Root path: %cd%\necho Open !NewName!.dproj in Delphi to continue\necho.\npause\n"