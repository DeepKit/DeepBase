package DeepBasePlatform;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}
{$DESCRIPTION 'DeepBase Platform Runtime Package'}
{$RUNONLY}

requires
  rtl,
  IndySystem,
  IndyCore,
  IndyProtocols,
  DeepBaseCore,
  DeepBaseServices,
  DeepBaseCommerce,
  vcl,
  RESTComponents,
  GR32; // PERCEPT-WYJX: Foundation for TBitmap32 + template matching (WYJX-P0)

contains
  DeepBase.Net in 'Features\DeepBase.Net.pas',
  DeepBase.Net.Transport.ICS in 'Features\DeepBase.Net.Transport.ICS.pas',
  DeepBase.HttpServer in 'Features\DeepBase.HttpServer.pas',
  DeepBase.Desktop.Lifecycle in 'Features\DeepBase.Desktop.Lifecycle.pas',
  DeepBase.Updater in 'Features\DeepBase.Updater.pas',
  DeepBase.AutoUpdate in 'Features\DeepBase.AutoUpdate.pas',
  DeepBase.AntiTamper in 'Features\DeepBase.AntiTamper.pas',
  // DeepBase.Unlock moved to DeepBaseCommerce.dpk
  DeepBase.CloudSync in 'Features\DeepBase.CloudSync.pas',
  DeepBase.CloudBackup in 'Features\DeepBase.CloudBackup.pas',
  DeepBase.Graph in 'Features\DeepBase.Graph.pas',
  UIAutomationClient_TLB in 'Features\UIAutomationClient_TLB.pas',
  DeepBase.ClipboardGuard in 'Features\DeepBase.ClipboardGuard.pas',
  DeepBase.WindowMonitor in 'Features\DeepBase.WindowMonitor.pas',
  DeepBase.UIA.Types in 'Features\DeepBase.UIA.Types.pas',
  DeepBase.UIA.Engine in 'Features\DeepBase.UIA.Engine.pas',
  // v0.7+: desktop perception layer (screenshot + visual recognition) and
  // the unified actuator that composes UIA + perception under fpBestEffort.
  // Note: the LLM-backed perception provider (DeepBase.Desktop.Perception.
  // LLMProvider) lives in DeepBaseLLM.dpk because it uses LLM units that are
  // owned by the LLM package, not Platform. Platform owns only the neutral
  // perception Types/Engine and the actuator that composes UIA + perception.
  DeepBase.Desktop.Perception.Types in 'Features\DeepBase.Desktop.Perception.Types.pas',
  DeepBase.Desktop.Perception.Engine in 'Features\DeepBase.Desktop.Perception.Engine.pas',
  DeepBase.Desktop.Perception.ColorMatch in 'Features\DeepBase.Desktop.Perception.ColorMatch.pas',
  // PERCEPT-WYJX-P1: Visual semantics analysis (badge/status/bubble)
  DeepBase.Desktop.Perception.BubbleAnalysis in 'Features\DeepBase.Desktop.Perception.BubbleAnalysis.pas',
  // PERCEPT-WYJX-P0: Template matching engine using TBitmap32 (GR32 dependency)
  DeepBase.Desktop.Perception.TemplateMatch in 'Features\DeepBase.Desktop.Perception.TemplateMatch.pas',
  // PERCEPT-WYJX-P0: Color matching primitives need TBitmap32 from Graphics32
  // Action layer (Coordinate/Motion/Scroll)
  DeepBase.Desktop.Coordinate in 'Features\DeepBase.Desktop.Coordinate.pas',
  DeepBase.Desktop.Actuation.Motion in 'Features\DeepBase.Desktop.Actuation.Motion.pas',
  DeepBase.Desktop.Actuation.Scroll in 'Features\DeepBase.Desktop.Actuation.Scroll.pas',
  // Action sequence engine (P2 - Core + Executors)
  DeepBase.Automation.ActionEngine.Core in 'Features\DeepBase.Automation.ActionEngine.Core.pas',
  DeepBase.Automation.ActionEngine.Mouse in 'Features\DeepBase.Automation.ActionEngine.Mouse.pas',
  DeepBase.Automation.ActionEngine.Keyboard in 'Features\DeepBase.Automation.ActionEngine.Keyboard.pas',
  DeepBase.Automation.ActionEngine.FileSystem in 'Features\DeepBase.Automation.ActionEngine.FileSystem.pas',
  DeepBase.Automation.ActionEngine.ControlFlow in 'Features\DeepBase.Automation.ActionEngine.ControlFlow.pas';
  
  // Advanced window finder (complements UIA with native Windows APIs)
  DeepBase.UIA.WindowFinder in 'Features\DeepBase.UIA.WindowFinder.pas';
  
  // Screen Click Enhancer (P3 - Image-based target detection & DPI-aware clicking)
  DeepBase.Desktop.Screen.Click.RegionLocator in 'Features\DeepBase.Desktop.Screen.Click.RegionLocator.pas',
  DeepBase.Desktop.Screen.Click.DPIMapper in 'Features\DeepBase.Desktop.Screen.Click.DPIMapper.pas',
  DeepBase.Desktop.Screen.Click.SmartExecutor in 'Features\DeepBase.Desktop.Screen.Click.SmartExecutor.pas';
  
  // Browser Automation Framework (P4 - DOM-level web automation with CDP)
  DeepBase.Browser.CDP.Adapter in 'Features\DeepBase.Browser.CDP.Adapter.pas',
  DeepBase.Browser.WebElement in 'Features\DeepBase.Browser.WebElement.pas',
  DeepBase.Browser.Session in 'Features\DeepBase.Browser.Session.pas',
  DeepBase.Browser.Recorder in 'Features\DeepBase.Browser.Recorder.pas';
  DeepBase.UIA.UnifiedActuator in 'Features\DeepBase.UIA.UnifiedActuator.pas';

end.
