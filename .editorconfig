# DeepBase Delphi Framework EditorConfig
# https://editorconfig.org

root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.pas]
indent_style = space
indent_size = 2
tab_width = 2

[*.dpr]
indent_style = space
indent_size = 2

[*.dpk]
indent_style = space
indent_size = 2

[*.dfm]
indent_style = space
indent_size = 2

[*.fmx]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.yml]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf
