<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
        <MainSource>DeepBaseGovernance.dpk</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <ProjectName Condition="'$(ProjectName)'==''">DeepBaseGovernance</ProjectName>
        <TargetedPlatforms>1741953</TargetedPlatforms>
        <AppType>Package</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>12.0</ProjectVersion>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)'=='Win32'">
        <DCC_DCUOutput>TestResults\dcu32</DCC_DCUOutput>
        <DCC_BPLOutput>TestResults\bpl32</DCC_BPLOutput>
        <DCC_DCPOutput>TestResults\dcp32</DCC_DCPOutput>
        <DCC_UnitSearchPath>TestResults\dcp32;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)'=='Win64' or '$(Platform)'=='Win64x'">
        <DCC_DCUOutput>TestResults\dcu64</DCC_DCUOutput>
        <DCC_BPLOutput>TestResults\bpl64</DCC_BPLOutput>
        <DCC_DCPOutput>TestResults\dcp64</DCC_DCPOutput>
        <DCC_UnitSearchPath>TestResults\dcp64;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <SanitizedProjectName>DeepBaseGovernance</SanitizedProjectName>
        <DCC_Description>DeepBase Governance (OCGS) Runtime Package</DCC_Description>
        <RuntimeOnlyPackage>true</RuntimeOnlyPackage>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="vcl.dcp"/>
        <DCCReference Include="DeepBaseCore.dcp"/>
        <DCCReference Include="DeepBasePersistence.dcp"/>
        <DCCReference Include="Governance\DeepBase.Governance.Types.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Interfaces.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Model.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.KeyResolver.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ActionGrid.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.GateResolver.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.JsonLogic.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.RouteResolver.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.DueChecker.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ActionExecutor.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.EvidenceRecorder.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.EvidenceStore.SQLite.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.RouteStore.SQLite.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ProjectionResolver.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.FeedbackResolver.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Runtime.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Validation.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.NativeRegistry.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.EventBridge.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ActionBinding.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.LegacyWrap.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Purpose.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Actor.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.AbilityRegistry.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Output.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ConfigLoader.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Run.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Seal.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ComponentAdapter.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Accountability.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ModelVersion.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Explain.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.AI.SteeringExporter.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.AI.ViewScopeEnforcer.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.AI.ProposalQueue.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ObserveGateResolver.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.ConfigRegistrar.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Lifecycle.pas"/>
        <DCCReference Include="Governance\DeepBase.Governance.Registration.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
