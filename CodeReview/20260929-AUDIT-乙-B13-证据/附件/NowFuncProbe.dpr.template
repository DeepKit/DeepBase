program NowFuncProbe;
{$APPTYPE CONSOLE}
uses
  System.SysUtils, System.DateUtils;
var
  Fixed: TDateTime;
begin
  Fixed := EncodeDateTime(2031, 3, 1, 12, 0, 0, 0);
  SetNowFunc(function: TDateTime
    begin
      Result := Fixed;
    end);
  Writeln('Now=', FormatDateTime('yyyy-mm-dd"T"hh:nn:ss', Now));
  Writeln('GetNowFunc<>nil=', GetNowFunc <> nil);
end.
