@echo off\nREM Build script for DeepBaseRun\nREM Usage: build.bat [debug|release]\n\nsetlocal enabledelayedexpansion\n\ncd /d \"%~dp0..\"\n\nif \"%1\"==\"\" (\n    set TARGET=Debug\n) else if /i \"%1\"==\"debug\" (\n    set TARGET=Debug\n) else if /i \"%1\"==\"release\" (\n    set TARGET=Release\n) else (\n    echo Invalid target. Use: build.bat [debug^|release]\n    exit /b 1\n)\n\necho Compiling DeepBaseRun (%TARGET%)...\n\nREM Try to find Delphi\nif exist \"C:\\Program Files\\Embarcadero\\Studio\\22.0\\bin\\rsvars.bat\" (\n    call \"C:\\Program Files\\Embarcadero\\Studio\\22.0\\bin\\rsvars.bat\"\n) else if exist \"C:\\Program Files (x86)\\Embarcadero\\Studio\\22.0\\bin\\rsvars.bat\" (\n    call \"C:\\Program Files (x86)\\Embarcadero\\Studio\\22.0\\bin\\rsvars.bat\"\n) else (\n    echo Delphi compiler not found\n    exit /b 1\n)\n\nREM Compile the project\nmsbuild DeepBaseRun.dproj /t:Build /p:Config=%TARGET% /verbosity:minimal\n\nif %ERRORLEVEL% equ 0 (\n    echo.\n    echo Build completed successfully\n    exit /b 0\n) else (\n    echo.\n    echo Build failed\n    exit /b 1\n)\n"