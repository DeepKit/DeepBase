        <DCC_UnitSearchPath>D:\\_Progs\\02Business\\DeepBase;D:\\_Progs\\02Business\\DeepBase\\Core;D:\\_Progs\\02Business\\DeepBase\\Services;D:\\_Progs\\02Business\\DeepBase\\Persistence;D:\\_Progs\\02Business\\DeepBase\\Features;D:\\_Progs\\02Business\\DeepBase\\VCL;D:\\_Progs\\02Business\\DeepBase\\FMX;D:\\_Progs\\02Business\\DeepBase\\Tools\\Studio\\Forms;D:\\_Progs\\02Business\\DeepBase\\Tools\\Studio\\Frames;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
