package UniBaseServices;

{$IMPLICITBUILD ON}
{$DESCRIPTION 'UniBase Services Runtime Package'}
{$RUNONLY}

requires
  rtl,
  vcl,
  IndySystem,
  IndyCore,
  IndyProtocols,
  dbrtl,
  FireDAC,
  FireDACCommonDriver,
  FireDACSqliteDriver,
  UniBaseCore;

contains
  UniBase.IoC in 'Core\UniBase.IoC.pas',
  UniBase.Math in 'Features\UniBase.Math.pas',
  UniBase.Serialization in 'Core\UniBase.Serialization.pas',
  UniBase.EventBus in 'Core\UniBase.EventBus.pas',
  UniBase.Scheduler in 'Core\UniBase.Scheduler.pas',
  UniBase.WorkerQueue in 'Core\UniBase.WorkerQueue.pas',
  UniBase.Services.Interfaces in 'Core\UniBase.Services.Interfaces.pas',
  UniBase.Services.Crypto in 'Core\UniBase.Services.Crypto.pas',
  UniBase.Services.Math in 'Core\UniBase.Services.Math.pas',
  UniBase.Services.Serialization in 'Core\UniBase.Services.Serialization.pas',
  UniBase.Services.Protection in 'Core\UniBase.Services.Protection.pas',
  UniBase.Services.Registration in 'Core\UniBase.Services.Registration.pas',
  UniBase.Crypto in 'Core\UniBase.Crypto.pas',
  UniBase.Crypto.OpenSSL in 'Core\UniBase.Crypto.OpenSSL.pas',
  UniBase.Crypto.PBKDF2 in 'Core\UniBase.Crypto.PBKDF2.pas',
  UniBase.Security.DPAPI in 'Core\UniBase.Security.DPAPI.pas',
  UniBase.KeyManager in 'Core\UniBase.KeyManager.pas',
  UniBase.FileWatcher in 'Core\UniBase.FileWatcher.pas',
  UniBase.SingleInstance in 'Core\UniBase.SingleInstance.pas',
  UniBase.AppLifecycle in 'Core\UniBase.AppLifecycle.pas',
  UniBase.RateLimiter in 'Core\UniBase.RateLimiter.pas',
  UniBase.Resilience in 'Core\UniBase.Resilience.pas',
  UniBase.Metrics in 'Core\UniBase.Metrics.pas',
  UniBase.LogAggregator in 'Core\UniBase.LogAggregator.pas',
  UniBase.LogQuery in 'Core\UniBase.LogQuery.pas',
  UniBase.LogAlert in 'Core\UniBase.LogAlert.pas',
  UniBase.LogDashboard in 'Core\UniBase.LogDashboard.pas',
  UniBase.Feedback in 'Core\UniBase.Feedback.pas',
  UniBase.License in 'Core\UniBase.License.pas',
  UniBase.Net in 'Core\UniBase.Net.pas',
  UniBase.Compression in 'Core\UniBase.Compression.pas',
  UniBase.ORM in 'Core\UniBase.ORM.pas';

end.
