<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{B8C9D0E1-F2A3-4567-1234-567890123457}</ProjectGuid>
        <MainSource>DeepBaseDataPlatform.dpk</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <ProjectName Condition="'$(ProjectName)'==''">DeepBaseDataPlatform</ProjectName>
        <TargetedPlatforms>1741953</TargetedPlatforms>
        <AppType>Package</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>12.0</ProjectVersion>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)'=='Win32'">
        <DCC_DCUOutput>TestResults\dcu32</DCC_DCUOutput>
        <DCC_BPLOutput>TestResults\bpl32</DCC_BPLOutput>
        <DCC_DCPOutput>TestResults\dcp32</DCC_DCPOutput>
        <DCC_UnitSearchPath>TestResults\dcp32;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Platform)'=='Win64' or '$(Platform)'=='Win64x'">
        <DCC_DCUOutput>TestResults\dcu64</DCC_DCUOutput>
        <DCC_BPLOutput>TestResults\bpl64</DCC_BPLOutput>
        <DCC_DCPOutput>TestResults\dcp64</DCC_DCPOutput>
        <DCC_UnitSearchPath>TestResults\dcp64;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <GenDll>true</GenDll>
        <GenPackage>true</GenPackage>
        <SanitizedProjectName>DeepBaseDataPlatform</SanitizedProjectName>
        <DCC_Description>DeepBase Data Platform Runtime Package</DCC_Description>
        <RuntimeOnlyPackage>true</RuntimeOnlyPackage>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="rtl.dcp"/>
        <DCCReference Include="DeepBaseCore.dcp"/>
        <DCCReference Include="DeepBaseServices.dcp"/>
        <DCCReference Include="DeepAxis.dcp"/>
        <DCCReference Include="DeepBasePlatform.dcp"/>
        <DCCReference Include="Core\DeepBase.SchemaAdapter.WeChat4x.pas"/>
        <DCCReference Include="Features\DeepBase.DataPlatform.Bootstrap.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Package</Borland.ProjectType>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
