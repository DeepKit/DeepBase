package DeepBaseSpeechASR;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}
{$DESCRIPTION 'DeepBase Speech ASR - SenseVoice + SAPI + Baidu backends'}
{$RUNONLY}

requires
  rtl,
  DeepBaseCore,
  DeepBaseSpeechCore;

contains
  DeepBase.Speech.SAPI.Decl in 'Features\DeepBase.Speech.SAPI.Decl.pas',
  DeepBase.Speech.ASR.SAPI in 'Features\DeepBase.Speech.ASR.SAPI.pas',
  DeepBase.Speech.ASR.Baidu in 'Features\DeepBase.Speech.ASR.Baidu.pas',
  DeepBase.Speech.FBank in 'Features\DeepBase.Speech.FBank.pas',
  DeepBase.Speech.ASR.SenseVoice in 'Features\DeepBase.Speech.ASR.SenseVoice.pas';

end.
